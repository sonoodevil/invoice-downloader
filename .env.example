# GEMINI API KEYS (Free Tier - up to 3 keys for load balancing)
# AI Studio automatically injects this at runtime from user secrets.
# Users configure these via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY_1="MY_GEMINI_API_KEY_1"
GEMINI_API_KEY_2="MY_GEMINI_API_KEY_2"
GEMINI_API_KEY_3="MY_GEMINI_API_KEY_3"

# GROQ API KEYS (Free Tier - up to 3 keys for load balancing)
# Groq provides free API access with rate limits.
# Users configure these via environment variables or secrets management.
GROQ_API_KEY_1="MY_GROQ_API_KEY_1"
GROQ_API_KEY_2="MY_GROQ_API_KEY_2"
GROQ_API_KEY_3="MY_GROQ_API_KEY_3"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
